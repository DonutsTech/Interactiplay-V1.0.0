{
  // Formatação automática
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // Ações automáticas ao salvar
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.removeUnusedImports": "explicit"
  },

  // Configurações do ESLint
  "eslint.enable": true,
  "eslint.probe": ["javascript", "typescript"],
  "eslint.format.enable": true,
  "eslint.lintTask.enable": true,
  "eslint.run": "onType",
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": ["./frontend", "./backend"],

  // Configurações específicas para TypeScript
  "typescript.validate.enable": true,
  "typescript.reportStyleChecksAsWarnings": true,
  "typescript.preferences.organizeImportsIgnoreCase": "auto",
  "typescript.preferences.includePackageJsonAutoImports": "auto",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",

  // Auto-save
  "files.autoSave": "onFocusChange",

  // Configurações do editor
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // Formatters específicos por linguagem
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Configurações para problemas
  "problems.showCurrentInStatus": true,
  "problems.autoReveal": true,
  "problems.decorations.enabled": true,
  
  // Configurações do editor para mostrar erros
  "editor.renderValidationDecorations": "on",
  "editor.showUnused": true,
  "editor.showDeprecated": true
}
