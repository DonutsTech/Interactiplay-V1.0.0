
upstream backend {
  server backend:4000;
}

server {
  listen 80;

  client_max_body_size 500M;  

   # API Backend
  location / {
    
    rewrite ^/backend/(.*)$ /$1 break;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;

    proxy_pass http://backend;
  }
}