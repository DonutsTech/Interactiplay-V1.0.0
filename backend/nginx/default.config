upstream backend {
  server backend:4000;
}

server {
  listen 80;
  listen [::]:80;
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name testeinteractiplay.duckdns.org;

  ssl_certificate /etc/letsencrypt/live/testeinteractiplay.duckdns.org/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/testeinteractiplay.duckdns.org/privkey.pem;

  
  client_max_body_size 500M;


   # API Backend
  location /api {

    rewrite ^/backend/(.*)$ /$1 break;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;

    proxy_pass http://backend;
  }

  # Widget static files - serve diretamente pelo backend
  location /widget/ {
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Headers para arquivos estáticos
    proxy_cache_bypass $http_upgrade;
    proxy_buffering off;

    # Passa diretamente para o backend mantendo o path completo
    proxy_pass http://backend;
  }

  # Webhook do Stripe
  location /data {
    rewrite ^/data/(.*)$ /$1 break;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;

    proxy_pass http://backend;
  }
}

server {
  listen 80;
  server_name ec2-35-173-188-226.compute-1.amazonaws.com;
  return 301 https://$host$request_uri;
}