upstream backend {
  server backend:4000;
}

server {
  listen 80;
  server_name experimenteumdonuts.app.br www.experimenteumdonuts.app.br;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name experimenteumdonuts.app.br www.experimenteumdonuts.app.br;

  client_max_body_size 500M;

  ssl_certificate /etc/letsencrypt/live/experimenteumdonuts.app.br/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/experimenteumdonuts.app.br/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    proxy_pass http://backend;
  }
}